build/
# Project dirs are working copies. Git keeps only the manifest; --build
# writes top.v, firmware.hex, sim.sh, .qsf, obj_dir, … locally.
projects/*
!projects/*/
!projects/baremetal/
!projects/soc/
!projects/standalone/
projects/*/*
!projects/*/target.4th
projects/baremetal/*
!projects/baremetal/*/
projects/baremetal/*/*
!projects/baremetal/*/target.4th
projects/soc/*
!projects/soc/*/
projects/soc/*/*
!projects/soc/*/target.4th
# soc_ecu_emul: track plant/viz + Makefile/README/tb (not --build tree)
!projects/soc/soc_ecu_emul/
!projects/soc/soc_ecu_emul/Makefile
!projects/soc/soc_ecu_emul/README.md
!projects/soc/soc_ecu_emul/plant/
!projects/soc/soc_ecu_emul/plant/**
!projects/soc/soc_ecu_emul/tb/
!projects/soc/soc_ecu_emul/tb/**
projects/soc/soc_ecu_emul/**/__pycache__/
projects/soc/soc_ecu_emul/plant/viz/native/engine_draw
projects/soc/soc_ecu_emul/plant/viz/native/mesh_probe/
projects/soc/soc_ecu_emul/tb/tb_ecu
projects/standalone/*
!projects/standalone/*/
projects/standalone/*/*
!projects/standalone/*/target.4th
forth-packages/
.fcov/
.fmcp/
*.o
tools/avr-con.bin
tools/avr-pin.bin
__pycache__/
out.vcd
trace.vcd
/tmp/
firmware/firmware.hex
.aider*

