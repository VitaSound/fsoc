\ Roots a j1a release image keeps so the console can still compile.
\ The second pass adds every word these names need. This file is not the image.

\ The host compiler looks these three up before it reads the image.
s" >r" release-root
s" r>" release-root
s" r@" release-root
s" quit" release-root
s" accept" release-root
s" find" release-root
s" :" release-root
s" ;" release-root
s" header" release-root
s" literal" release-root
s" compile," release-root
s" ]" release-root
s" [" release-root
s" postpone" release-root
s" create" release-root
s" 'BOOT" release-root
