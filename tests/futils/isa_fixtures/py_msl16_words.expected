: call, (dest -- )
   \ TODO: implement call ;
\ TODO: dcw has a variable/complex encoding (2-byte)
\         not auto-generated. See fsys/fasm/msl16/words.4th.
: dcw, (u -- )
   \ TODO: implement dcw ;
: msl16-span ( c-addr u -- n )
   2dup s" lit," compare 0= r> or >r 2dup s" call," compare 0= r> or >r 2dup s" dcw," compare 0=
   if 2drop 2 exit then
   r> drop
   2drop 1 ;