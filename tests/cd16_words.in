: neg? dup 0< if negate then ;
: bump 1+ ;
: count3 0 begin bump dup 3 = until . ;
: nest 5 >r r@ . r> . ;
: poke here ! ;
: peek here @ ;
: hi s" cd16" type ;
: max2 over over < if swap then drop ;
: min2 over over > if swap then drop ;
: fstep swap over * swap 1- ;
: fact dup 2 < if drop 1 exit then 1 swap begin fstep dup 1 = until drop ;
: fact2 fact double ;
: choose if i2 else i1 then ;
: keep 2dup + . 2drop ;
: sumover over + swap drop . ;
: poke10 10 here ! ;
: plus! +! ;
: show! poke10 5 here plus! here @ . ;
: bits 3 1 and 1 2 or xor 0 invert xor . ;
: spin rot rot .s ;
: parity dup 1 and if drop 49 else drop 48 then emit ;
: stop? dup 4 = ;
: upto 0 begin 1+ dup . stop? if drop exit then again ;
: abc 65 emit 66 emit 67 emit ;
: done 68 emit 79 emit 78 emit 69 emit ;
